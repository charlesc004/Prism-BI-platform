{
  "name": "@prism/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/jobs/worker.ts",
    "build": "tsc --noEmit",
